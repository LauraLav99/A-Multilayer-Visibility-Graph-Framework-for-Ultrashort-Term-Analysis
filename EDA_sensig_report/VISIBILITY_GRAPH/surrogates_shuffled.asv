% This routine creates the homologous and non-homologous surrogates. It uses
% as input the trainer and trainee tables generated by create_surrogate_tables.m.
% The script generates the surrogates by shuffling the trainee windows with
% those of trainers who did not participate in the same session.

clear; 
clc;
close all;

warning('off','all');
addpath('\fast_NVG')
addpath('\fast_HVG')
addpath('\sigstar')
addpath('\MutualInfo')
addpath('\MOONSHINE\MATLAB\subroutines')
addpath('\ESGO\entropia')
addpath('\Mddisten')
addpath('\embedding')

deskPath = '';
saveRootFolder = 'RISULTATI_MOONSHINE';
esgosavefolder = fullfile(deskPath, saveRootFolder, 'ESGO_EDA_SMNA', "SURROGATES", "tables");

window_len = '60'; 
filenamecat = sprintf('Processed_Signals_for_Surrogates_%s.mat', window_len);
save_filename = fullfile(esgosavefolder, filenamecat);

load(save_filename); 

% ---Intialization ---
traineeIDs_clean = string(traineeCells(2:end, 1));
condizioni_presenti = unique(string(traineeCells(2:end, 5))); 

featureNames = {'AEO', 'I_tot', 'I_tot2', 'DA', 'L', 'Edd', 'Lambda', 'C_tot'};
nFeats = length(featureNames);
min_points_required = 10; 

for c = 1:length(condizioni_presenti)
    targetCondition = condizioni_presenti(c);
    fprintf('\n=== Surrogates library not homologous: %s ===\n', targetCondition);
    
    rows_cond = find(string(traineeCells(2:end, 5)) == targetCondition);
    allTrainees = unique(traineeIDs_clean(rows_cond));
    
    surrLibrary = struct(); 
    
    for i = 1:length(allTrainees)
        tID = allTrainees(i);
        vFieldName = matlab.lang.makeValidName(tID);
        
        % =========================================================================
        % STRUCTURE: Intial metadata(1:5), VG descriptors (6:13), tracking
        % metadata(14:17
        % =========================================================================
        meta_start = {'PseudoTrainer', 'TraineeDate', 'TrainerDate', 'SessionType', 'PairID'};
        meta_end   = {'TraineeCond', 'TrainerCond', 'TrainerSession', 'PairCondition'};
        
        varNames = [meta_start, featureNames, meta_end];
        varTypes = [repmat({'string'}, 1, length(meta_start)), ...
                    repmat({'double'}, 1, nFeats), ...
                    repmat({'string'}, 1, length(meta_end))];
        
        surrLibrary.(vFieldName) = table('Size', [0, length(varNames)], ...
            'VariableTypes', varTypes, 'VariableNames', varNames);
        
        tRows = find(traineeIDs_clean == tID & string(traineeCells(2:end, 5)) == targetCondition);
        tRows = tRows + 1; 
        
        for tr = 1:length(tRows)
            rT = tRows(tr);
            tGroup = traineeCells{rT, 2};
            tDate  = string(traineeCells{rT, 4});
            tSType = string(getSessionType(tDate)); % Session Trainee
            tCond  = string(traineeCells{rT, 5});   % Condition Trainee
            tSignals = traineeCells{rT, 6}; 
            
            % SELEZIONA TUTTE LE CASISTICHE: qualsiasi trainer di un ALTRO gruppo
            %Select any trianer from any other  program gr
            validTrainerIdx = find([trainerCells{2:end, 1}]' ~= tGroup);
            validTrainerIdx = validTrainerIdx + 1;
            
            for v = 1:length(validTrainerIdx)
                rTr = validTrainerIdx(v);
                trID    = string(trainerCells{rTr, 2}); 
                trDate  = string(trainerCells{rTr, 4}); 
                trSType = string(getSessionType(trDate)); % Sessione Trainer
                trCond  = string(trainerCells{rTr, 5});   % Condizione Trainer
                trSignals = trainerCells{rTr, 6}; 
                
                pairCondLabel = sprintf('%s_vs_%s', tCond, trCond);
                
                % --- TUTTE LE CASISTICHE DI FINESTRA (SHUFFLE TOTALE) ---
                for wT = 1:length(tSignals)
                    for wTr = 1:length(trSignals)
                        sigT = tSignals{wT};
                        sigTr = trSignals{wTr};
                        
                        minLength = min(length(sigT), length(sigTr));
                        if minLength < min_points_required, continue; end
                        
                        try
                            feats = extractMultiplexVGfeatures(sigT(1:minLength), sigTr(1:minLength));
                            resVec = [feats.AEO, feats.I_tot, feats.I_tot2, feats.DA, feats.L, feats.Edd, feats.Lambda, feats.C_tot];
                            
                            pairID = sprintf('T%d-Tr%d', wT, wTr);
                            
                            % Costruzione riga: Metadati 1:5, poi Misure (6:13), poi Metadati 14:17
                            newEntry = [{trID, tDate, trDate, tSType, pairID}, ...
                                        num2cell(resVec), ...
                                        {tCond, trCond, trSType, pairCondLabel}];
                            
                            surrLibrary.(vFieldName) = [surrLibrary.(vFieldName); newEntry];
                        catch
                            continue;
                        end
                    end
                end
            end
        end
        fprintf('  > %s: %d combinazioni create.\n', tID, height(surrLibrary.(vFieldName)));
    end

    % Salvataggio Master Library
    outputFileName = sprintf('Surrogate_Detailed_Tracked_%s_%s.mat', targetCondition, window_len);
    outpath = fullfile(esgosavefolder, outputFileName);
    save(outpath, 'surrLibrary', 'featureNames', 'targetCondition', '-v7.3');
    fprintf('Libreria salvata: %s\n', outputFileName);
end

fprintf('\n*** GENERAZIONE ESAUSTIVA COMPLETATA ***\n');

function type = getSessionType(expDate)
    expDate = char(expDate);
    firstDates = {'2310', '1004', '301025'};
    lastDates  = {'1101', '1206', '041225'};
    if any(strcmp(expDate, firstDates)), type = 'First';
    elseif any(strcmp(expDate, lastDates)), type = 'Last';
    else, type = 'Middle'; end
end